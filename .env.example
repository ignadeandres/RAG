# Copia este fichero a .env y rellena los valores. Nunca subas .env a git.

# --- Embeddings (por defecto bge-m3 local en Ollama; no requiere clave) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# Alternativa: EMBEDDING_PROVIDER=openai + OPENAI_API_KEY=sk-...

# --- Reranker (opcional: sin clave se usa el orden de la fusión BM25 + vectorial) ---
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_THRESHOLD=0.04

# --- Base de datos (dentro de docker compose se sobreescribe con el host "postgres") ---
DATABASE_URL=postgresql://roboost:roboost@localhost:5432/roboost

# --- LLM local (Ollama nativo del host) ---
# Desde los contenedores docker compose usa http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3.5:9b

# --- Ingesta y recuperación ---
REINDEX_INTERVAL_SECONDS=300
CHUNK_SIZE=3200
CANDIDATES_PER_RETRIEVER=20
FUSION_TOP=10
FINAL_TOP_K=4
WEIGHT_VECTOR=1.0
WEIGHT_BM25=1.0

# --- Usuarios de la UI: usuario:hash_bcrypt:rol separados por comas ---
# Genera un hash con: python -m roboost_rag hash-password
# Usa comillas simples: los hashes contienen '$'.
APP_USERS='ana:$2b$12$...:public,luis:$2b$12$...:hr_manager'
